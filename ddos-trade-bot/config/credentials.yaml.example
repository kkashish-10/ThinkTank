# Credentials Configuration Template
# Copy to credentials.yaml and fill in your actual credentials
# NEVER commit credentials.yaml with real keys!

# Alpaca Broker Credentials
alpaca:
  api_key: "your_alpaca_api_key_here"
  secret_key: "your_alpaca_secret_key_here"
  base_url: "https://paper-api.alpaca.markets"  # Paper trading endpoint
  # base_url: "https://api.alpaca.markets"      # Live trading endpoint (use with caution)

# Email Notification Credentials
email:
  smtp_server: "smtp.gmail.com"
  smtp_port: 587
  sender_email: "your_email@gmail.com"
  sender_password: "your_app_password_here"
  recipient_emails:
    - "alert_recipient@example.com"

# Webhook Endpoints (optional)
webhooks:
  slack: "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
  discord: "https://discordapp.com/api/webhooks/YOUR/WEBHOOK/URL"

# Database (if using)
database:
  type: "sqlite"  # sqlite, postgresql, mysql
  path: "data/trading_bot.db"  # For sqlite
  # host: "localhost"
  # port: 5432
  # username: "user"
  # password: "password"
  # database: "trading_bot_db"
