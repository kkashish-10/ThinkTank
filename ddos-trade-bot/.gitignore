# Python Project Gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Virtual environments
venv/
ENV/
env/
.venv
venv.bak/
env.bak/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# Credentials and secrets (NEVER commit these!)
.env
.env.local
.env.*.local
credentials.yaml
config/credentials.yaml
secrets.yaml

# Logs
logs/
*.log

# Data
data/
*.db
*.sqlite
*.sqlite3

# Backtest results
backtest_results/
*.csv

# OS files
Thumbs.db
.DS_Store

# Project-specific
.env.production
live_trading_disabled.txt
